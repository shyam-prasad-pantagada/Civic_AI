# Civic_AI Environment Configuration
# Optional: All keys are optional. If left blank, Civic_AI automatically uses
# built-in local offline fallback datasets and deterministic rules so all modules function offline.

# AI Model API Key for summarization, multimodal vision OCR, and live synthesis
LLM_API_KEY=

# AI Model Name (defaults to gemini-2.5-flash)
LLM_MODEL=gemini-2.5-flash

# Search API Key for real-time live circular & deadline verification on *.gov.in / *.nic.in
TAVILY_API_KEY=

# Backend API URL for frontend
VITE_API_URL=http://localhost:8000
